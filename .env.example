# Gemini API Configuration (Server-side only)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001

# ---- Model selection ----
# Set your preferred Gemini model ONCE here; both the fast path and synthesis use it
# unless you override a specific stage below.
# Examples: gemini-3-flash-preview, gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash
#
# Optional per-stage overrides (these win over GEMINI_MODEL):
#   FLASH = fast path (seed / ideas / clustering), PRO = synthesis report
# GEMINI_FLASH_MODEL=gemini-3.1-flash-lite
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Comma-separated browser origins allowed to call the API proxy.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.example

# Optional quota controls for the Gemini proxy.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=60

# Optional API request token. Keep the server token secret. Only set the Vite
# token if you intentionally want the browser to send the same shared token.
# API_REQUEST_TOKEN=
# VITE_API_REQUEST_TOKEN=
